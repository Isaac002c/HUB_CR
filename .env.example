# Safe local-development template only. Never use these values in production.
# Generate a private secret with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
POSTGRES_DB=cr_recursos
POSTGRES_USER=cr_recursos
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://cr_recursos:replace-with-local-password@localhost:5432/cr_recursos?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret

FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
BASE_URL=http://localhost:5000
APP_URL=http://localhost:3001

# Optional email provider configuration. Leave credentials blank for local use.
EMAIL_PROVIDER=
EMAIL_AUTOMATION_ENABLED=false
EMAIL_DOMAIN_VERIFIED=false
EMAIL_FROM_NAME=CR Recursos
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=
EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_MS=10000
EMAIL_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=5
EMAIL_PROCESSING_TIMEOUT_MINUTES=10
