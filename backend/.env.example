# Safe local-development template. Replace secrets before use.
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
DATABASE_URL=postgresql://cr_recursos:replace-with-local-password@localhost:5432/cr_recursos?sslmode=disable
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3001
NODE_ENV=development
BASE_URL=http://localhost:5000

# Email is disabled until a provider is configured.
EMAIL_PROVIDER=
EMAIL_AUTOMATION_ENABLED=false
EMAIL_DOMAIN_VERIFIED=false
EMAIL_FROM_NAME=CR Recursos
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=
EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
APP_URL=http://localhost:3001
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_MS=10000
EMAIL_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=5
EMAIL_PROCESSING_TIMEOUT_MINUTES=10
